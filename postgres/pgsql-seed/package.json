{
  "name": "pgsql-seed",
  "version": "3.17.0",
  "author": "Constructive <developers@constructive.io>",
  "description": "PostgreSQL seeding utilities with pgpm integration - batteries included",
  "main": "index.js",
  "module": "esm/index.js",
  "types": "index.d.ts",
  "homepage": "https://github.com/constructive-io/constructive",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/constructive-io/constructive"
  },
  "bugs": {
    "url": "https://github.com/constructive-io/constructive/issues"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "seed",
    "seeding",
    "csv",
    "json",
    "sql",
    "pgpm",
    "migrations",
    "data-loading",
    "constructive"
  ],
  "scripts": {
    "clean": "makage clean",
    "prepack": "npm run build",
    "build": "makage build",
    "build:dev": "makage build --dev",
    "lint": "eslint . --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/pg": "^8.20.4",
    "makage": "^0.8.0"
  },
  "dependencies": {
    "@pgpmjs/core": "workspace:^",
    "@pgpmjs/env": "workspace:^",
    "pg": "^8.21.0",
    "pg-env": "workspace:^",
    "pg-seed": "workspace:^"
  }
}
