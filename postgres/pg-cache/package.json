    "pg": "^8.21.0",
    "pg-env": "workspace:^"
  },
  "devDependencies": {
    "@types/pg": "^8.20.4",
    "makage": "^0.8.0"
  },
  "keywords": [
    "postgresql",
    "pg",
    "pool",
    "cache",
    "lru",
    "connection",
    "constructive"
  ]
