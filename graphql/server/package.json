{
  "name": "@constructive-io/graphql-server",
  "version": "5.29.2",
  "author": "Constructive <developers@constructive.io>",
  "description": "Constructive GraphQL Server",
  "main": "index.js",
  "module": "esm/index.js",
  "types": "index.d.ts",
  "homepage": "https://github.com/constructive-io/constructive",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/constructive-io/constructive"
  },
  "bugs": {
    "url": "https://github.com/constructive-io/constructive/issues"
  },
  "scripts": {
    "clean": "makage clean",
    "prepack": "npm run build",
    "build": "makage build",
    "build:dev": "makage build --dev",
    "dev": "ts-node src/run.ts",
    "dev:watch": "nodemon --watch src --ext ts --exec ts-node src/run.ts",
    "debug:memory:analyze": "node scripts/analyze-debug-logs.mjs",
    "debug:heap:capture": "node scripts/capture-heap-snapshot.mjs",
    "lint": "eslint . --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "server",
    "graphql",
    "express",
    "constructive",
    "backend"
  ],
  "dependencies": {
    "@agentic-kit/ollama": "workspace:*",
    "@constructive-io/csrf": "workspace:^",
    "@constructive-io/errors": "workspace:^",
    "@constructive-io/express-context": "workspace:^",
    "@constructive-io/graphql-env": "workspace:^",
    "@constructive-io/graphql-types": "workspace:^",
    "@constructive-io/llm-env": "workspace:^",
    "@constructive-io/query-builder": "workspace:^",
    "@constructive-io/s3-utils": "workspace:^",
    "@constructive-io/url-domains": "workspace:^",
    "@graphile-contrib/pg-many-to-many": "2.0.0-rc.2",
    "@pgpmjs/env": "workspace:^",
    "@pgpmjs/logger": "workspace:^",
    "@pgpmjs/server-utils": "workspace:^",
    "@pgpmjs/types": "workspace:^",
    "@pgsql/quotes": "^18.2.4",
    "@simplewebauthn/server": "13.3.2",
    "cors": "^2.8.6",
    "deepmerge": "^4.3.1",
    "express": "^5.2.1",
    "gql-ast": "workspace:^",
    "grafast": "1.1.2",
    "grafserv": "1.0.1",
    "graphile-build": "5.1.1",
    "graphile-build-pg": "5.1.3",
    "graphile-cache": "workspace:^",
    "graphile-config": "1.1.0",
    "graphile-function-bindings": "workspace:^",
    "graphile-plugin-utils": "workspace:^",
    "graphile-scoped-introspection": "workspace:^",
    "graphile-settings": "workspace:^",
    "graphile-utils": "5.0.3",
    "graphql": "16.13.0",
    "graphql-upload": "^13.0.0",
    "lru-cache": "^11.2.7",
    "pg": "^8.21.0",
    "pg-cache": "workspace:^",
    "pg-env": "workspace:^",
    "pg-query-context": "workspace:^",
    "pg-sql2": "5.0.1",
    "postgraphile": "5.1.4",
    "request-ip": "^3.3.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1052.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/graphql-upload": "^8.0.12",
    "@types/pg": "^8.20.4",
    "@types/request-ip": "^0.0.41",
    "@types/supertest": "^7.2.1",
    "cookie-parser": "^1.4.7",
    "graphile-test": "workspace:*",
    "makage": "^0.8.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2"
  }
}
